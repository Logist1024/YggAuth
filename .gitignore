# 依赖
node_modules/
.pnpm-store/

# 构建产物
bin/
/yggauth

# internal/webserver/dist 是 go:embed 的输入,必须入库 ——
# 漏掉它,新克隆的仓库直接 go build 就会因为找不到嵌入文件而失败。
# 这里刻意不写任何 dist 规则;web/ 下可能意外出现的输出由 web/.gitignore 兜住。

# 运行时数据(皮肤文件、备份、上传缓存)
data/

# 日志与临时文件
*.log
*.tmp

# 环境与密钥
.env
.env.*
!.env.example
*.pem
*.key

# 测试与覆盖率
coverage.out
coverage.html
*.test

# 编辑器与系统
.DS_Store
.idea/
.vscode/