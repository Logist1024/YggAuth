{
  "name": "yggauth-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @yggauth/account-web build && pnpm --filter @yggauth/admin-web build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "~10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
