# YggAuth 环境变量清单
#
# 用法:cp .env.example .env,至少改这四项:
#   APP_PUBLIC_DOMAIN / PUBLIC_BASE_URL / KEY_MASTER_SECRET / DB_PASSWORD
#
# 本文件是配置的**唯一真源**:config.Load 读的每个变量这里都有一行,
# 反向由 internal/config/envfiles_test.go 双向核对 —— 少一行或多一行都会让测试失败。
#
# 标记「必填」的项目缺失时服务**启动即退出**并指出缺哪个,
# 不会静默使用默认值。

# ============================================================ 应用

# 监听地址。容器内必须是 0.0.0.0,否则外部连不上
APP_HOST=0.0.0.0
APP_PORT=3000

# 【必填】终端用户站域名。用于推导 SSO cookie 父域与皮肤站 skinDomains
APP_PUBLIC_DOMAIN=auth.example.com

# 【必填】对外完整基址。**OIDC issuer 就是它**,必须与实际访问域名完全一致
# (含协议),否则标准 OIDC 客户端会在验签阶段拒绝所有令牌
PUBLIC_BASE_URL=https://auth.example.com

# 管理后台域名。留空表示与终端用户站同域,按路径前缀分流
ADMIN_DOMAIN=

# 运行时数据目录(皮肤文件、头像、备份)
DATA_DIR=./data

# 皮肤/披风与备份的落盘目录。留空时按 DATA_DIR 推导
# (布局分别是 <DATA_DIR>/textures/<sha256前2位>/… 与 <DATA_DIR>/backups)
TEXTURE_DIR=
BACKUP_DIR=

# 是否信任 X-Forwarded-For / X-Real-IP。
# 只有当服务确实跑在 nginx 之类的反代**之后**时才设为 true,
# 直接暴露公网时保持 false —— 否则攻击者可以伪造 IP 污染审计日志
TRUST_PROXY_HEADERS=false

# 优雅退出最长等待时间
SHUTDOWN_TIMEOUT=20s

# 迁移文件目录。留空用编进二进制的迁移;指向磁盘目录可覆盖迁移文件
MIGRATIONS_DIR=

# ============================================================ 数据库

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=yggauth
DB_USER=yggauth

# 【必填】
DB_PASSWORD=

# disable | require | verify-ca | verify-full
# 生产环境连外部 PostgreSQL 请用 require 及以上
DB_SSLMODE=disable

# 连接池。0 表示交给 pgx 按 CPU 核数推断
DB_MAX_CONNS=0
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_CONNECT_TIMEOUT=10s

# 启动时自动执行迁移
DB_AUTO_MIGRATE=true

# ============================================================ 密钥

# 【必填】私钥加密主密钥。生成方式:openssl rand -hex 32
# 一旦修改,库里所有已加密的签名私钥都无法再解密,必须重新轮换密钥
KEY_MASTER_SECRET=

# ============================================================ 账号内核

# 密码长度策略。变更 C-1:旧版是 6–18,新版放宽到 8–128
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

# 拒绝弱口令库中的常见密码(变更 C-2:不再强制大小写+数字组合)
PASSWORD_REJECT_COMMON=true

# Have I Been Pwned k-anonymity API。留空则跳过泄露检查(离线环境)
HIBP_ENDPOINT=https://api.pwnedpasswords.com/range

# argon2id 参数,默认取 RFC 9106 第二档。升级参数只需改这里
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=1
ARGON2_PARALLELISM=4

# 登录失败锁定策略
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900

# 会话有效期。滑动过期与绝对过期
SESSION_IDLE_TTL=168h
SESSION_MAX_TTL=720h
SESSION_COOKIE_NAME=ygg_session

# open | invite_only(env 只接受这两种,改完要重启)
# 彻底关闭注册请到后台「设置」把 registration.mode 改成 closed ——
# 后台改的是 app.setting,不重启即生效(env 是种子,setting 是现值)
REGISTRATION_MODE=open

# 新账号的通用布尔开关默认值(变更 C-8)
MC_LOGIN_DEFAULT=true

# 邮箱令牌有效期
EMAIL_TOKEN_TTL=24h
INVITE_TOKEN_TTL=168h

# ============================================================ 首启引导(L2)

# 库里还没有管理员时,首次启动自动创建默认管理员并写 system.installed_at。
# **已有管理员即跳过**:即使把管理员删光,重启也不会再自动补一个 ——
# 补号只可能通过下面的 yggauth admin create 手工发生。
ADMIN_BOOTSTRAP=true

# 默认管理员身份。仅首次引导生效,之后改动不影响已存在的账号
ADMIN_EMAIL=admin@localhost.local
ADMIN_USERNAME=admin

# 默认管理员密码。留空(推荐)= 随机生成 24 位,只在启动日志里打印一次;
# 显式填写则必须在首次登录后改掉(must_change 强制改密)
ADMIN_PASSWORD=

# ============================================================ OIDC

# 强制 PKCE。OAuth 2.1 的硬性要求,生产必须保持 true
OIDC_REQUIRE_PKCE=true

OIDC_ACCESS_TOKEN_TTL=1h
OIDC_ID_TOKEN_TTL=1h
OIDC_AUTH_CODE_TTL=60s
OIDC_REFRESH_TOKEN_TTL=720h

# 推送授权请求(RFC 9126)与设备码流程(RFC 8628)
OIDC_PAR_TTL=90s
OIDC_DEVICE_CODE_TTL=15m

# SSO 会话 cookie
SSO_COOKIE_NAME=ygg_sso

# cookie 域。留空则由 APP_PUBLIC_DOMAIN 自动推导父域
# ⚠️ 本地用 localhost 时必须留空,且 SSO_COOKIE_SECURE=false,
#    否则浏览器直接丢弃 cookie,SSO 静默发码会「莫名」失效
SSO_COOKIE_DOMAIN=
SSO_COOKIE_SECURE=true
SSO_COOKIE_SAMESITE=Lax

# CORS 白名单,逗号分隔。生产建议留空,走 OIDC 客户端回调地址白名单
# 绝不能填 *(它无法与凭据同时使用)
CORS_ALLOWED_ORIGINS=

# ============================================================ Minecraft

MC_ENABLED=true

# 只读模式:禁止上传,下载不受影响
MC_READONLY=false

# 外部皮肤站回源
MC_SKIN_EXTERNAL=false
MC_SKIN_EXTERNAL_TIMEOUT=5s
# 回源基址。MC_SKIN_EXTERNAL=true 时必填,形如 https://skins.example.com
MC_SKIN_EXTERNAL_BASE_URL=
# 连续失败多少次后熔断短路
MC_SKIN_EXTERNAL_FAILURES=5
# 熔断后半开等待时长
MC_SKIN_EXTERNAL_RESET=60s

# 与 authlib-injector 的预共享密钥。留空则必须在后台登记 MC 服务器
MC_SERVER_SHARED_SECRET=

# hasJoined 的 serverId 有效时间窗,超出即拒绝(防重放)
MC_HASJOINED_WINDOW=3m

# 材质上传上限(MB)
MC_SKIN_MAX_SIZE_MB=2

# 头像
MC_AVATAR_SIZE=64
MC_AVATAR_QUEUE_SIZE=256

# 改名后旧名保留天数,期间禁止他人注册
MC_NAME_RETENTION_DAYS=90

# ============================================================ 邮件

# console(打到日志) | smtp
MAILER_TRANSPORT=console
MAILER_FROM=noreply@example.com
MAILER_FROM_NAME=YggAuth

# MAILER_TRANSPORT=smtp 时必填
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# 重发验证邮件的节流
MAIL_VERIFY_COOLDOWN_SECONDS=60
MAIL_VERIFY_DAILY_LIMIT=5

# ============================================================ 日志与监控

# debug | info | warn | error
LOG_LEVEL=info

# json | text
LOG_FORMAT=json

# 记录调用位置,排障时打开,生产建议关闭(日志量大)
LOG_ADD_SOURCE=false

# 慢请求日志阈值
LOG_SLOW_REQUEST=1s

# ⚠️ 生产必须保持 false —— 打开会把请求体(含密码)写进日志
LOG_REQUEST_BODY=false