# YggAuth 测试环境变量模板
#
# 用法:
#   cp deploy/test/test.env.example .env.test
#
# 放在仓库根的 .env.test,而不是 deploy/test/ 下面:
# 挡住 .env.test 的是 .gitignore 里的 `*.test` 规则,换个文件名就没有规则匹配了。
# 真实密钥进了 git 历史,删掉文件也删不掉 —— 必须当作已泄露处理。
#
# 只列测试环境真正需要动的项。默认值取自 internal/config/config.go 的 Load(),
# 根编排透传的其余变量见 docker-compose.test.yml。

# ============================================================ 必填(与生产一致)
#
# 这四项缺失时服务**启动即退出**,并一次性列出全部问题。
# 测试环境不要为了图省事关掉校验:配置错了却带着跑起来,
# 排查方向会完全跑偏。

# 明文 HTTP 的本机部署:localhost 能通过配置里的本地地址豁免。
# 换成自己的测试域名时,把 SSO_COOKIE_SECURE 一并改成 true 并走路线 C。
APP_PUBLIC_DOMAIN=localhost
PUBLIC_BASE_URL=http://localhost:3000

# 占位值,必须换掉。docs/10-test-deployment.md 3.2 节给了生成命令。
DB_PASSWORD=change-me-in-test-env

# 生成方式:openssl rand -hex 32
# 一旦修改,库里所有已加密的签名私钥都无法再解密,必须重新轮换密钥。
# 测试环境重置数据后建议也换一个新的,避免养成「密钥可以随便改」的习惯。
KEY_MASTER_SECRET=

# ============================================================ 站点

# 直接暴露在宿主机的哪个端口。app 容器内仍然是 3000。
TEST_PORT=3000

# 后台入口。留空表示与终端用户站同域。
# ⚠️ 当前 ADMIN_DOMAIN 只出现在启动日志里,不参与路由 ——
#    管理后台固定挂在 /admin 前缀下,见 docs/10-test-deployment.md 第九节。
ADMIN_DOMAIN=

# ============================================================ 调试

# text 而不是 json:docker compose logs 直接可读。
# 排查问题时把 LOG_ADD_SOURCE 打开,日志会带上 文件:行号。
LOG_LEVEL=debug
LOG_FORMAT=text
LOG_ADD_SOURCE=true
LOG_REQUEST_BODY=false

# ============================================================ 注册与登录

# open 允许任意注册;invite_only 需要邀请码。
# 公网可达的测试环境建议 invite_only:否则会有人拿你的测试站练手。
REGISTRATION_MODE=open

# ⚠️ 留空**不会**关闭泄露检查:空串被当成未设置,会回落到默认地址。
# 当前装配没有注入 LeakChecker,检查实际上一律不执行 ——
# 详见 docs/10-test-deployment.md 第九节。想验这条逻辑得先补装配。
HIBP_ENDPOINT=

# 想验证账号锁定逻辑时,可以把阈值调低,不必真的试错 5 次。
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900

# ============================================================ SSO cookie

# 明文 HTTP 下必须为 false,否则浏览器直接丢弃 cookie,
# 表现为「SSO 静默发码莫名失效」—— 没有任何报错,最难查的一类问题。
SSO_COOKIE_SECURE=false

# 必须留空。由 APP_PUBLIC_DOMAIN 推导父域;localhost 没有父域。
SSO_COOKIE_DOMAIN=

# ============================================================ 邮件

# console 把邮件内容打进日志,验证链接直接在 docker compose logs 里。
MAILER_TRANSPORT=console
MAILER_FROM=noreply@test.local

# 改成 smtp 时必填。注意键名是 SMTP_USER 而不是 SMTP_USERNAME,
# 详见 docs/10-test-deployment.md 第九节。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# ============================================================ Minecraft

MC_ENABLED=true

# 只读模式:禁止上传,下载不受影响。多人共用一个测试服时打开。
MC_READONLY=false

# 外部皮肤站回源。留空则回源到本服务的公开基址。
# 这一项应用读得到,但根编排没透传、.env.example 也没写,
# 覆盖层里补上了 —— 见 docs/10-test-deployment.md 第九节。
MC_SKIN_EXTERNAL=false
MC_SKIN_EXTERNAL_BASE_URL=

# 与 authlib-injector 的预共享密钥。留空则必须在后台登记 MC 服务器。
MC_SERVER_SHARED_SECRET=

# ============================================================ 其它

TZ=Asia/Shanghai

# 仅用于镜像标签与 `yggauth version` 输出,不影响行为。
VERSION=test